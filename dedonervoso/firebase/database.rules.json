{
  "rules": {
    "invites": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".write": "auth != null && (auth.uid === $from || auth.uid === $to)",
          ".validate": "$from !== $to && newData.hasChildren(['duel', 'nick', 'avatar', 'at'])",
          "duel": {
            ".validate": "newData.isString() && root.child('duels').child(newData.val()).child('host').val() === $from && root.child('duels').child(newData.val()).child('guest').val() === $to"
          },
          "nick": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 16" },
          "avatar": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 31" },
          "at": { ".validate": "newData.val() === now" },
          "$other": { ".validate": false }
        }
      }
    },
    "duels": {
      "$duel": {
        ".read": "auth != null && (data.child('host').val() === auth.uid || data.child('guest').val() === auth.uid)",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || (!newData.exists() && (data.child('host').val() === auth.uid || data.child('guest').val() === auth.uid)))",
        ".validate": "$duel.matches(/^[A-Za-z0-9_-]{8,40}$/) && newData.hasChildren(['host', 'guest', 'seed', 'createdAt']) && (data.exists() || !(newData.hasChild('accepted') || newData.hasChild('startAt') || newData.hasChild('cancelled') || newData.hasChild('players') || newData.hasChild('items')))",
        "host": { ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())" },
        "guest": { ".validate": "newData.isString() && newData.val() !== newData.parent().child('host').val() && (!data.exists() || newData.val() === data.val())" },
        "seed": { ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())" },
        "createdAt": { ".validate": "(!data.exists() && newData.val() === now) || newData.val() === data.val()" },
        "accepted": {
          ".write": "auth != null && !data.exists() && auth.uid === data.parent().child('guest').val()",
          ".validate": "newData.isBoolean()"
        },
        "startAt": {
          ".write": "auth != null && !data.exists() && auth.uid === data.parent().child('host').val() && data.parent().child('accepted').val() === true",
          ".validate": "newData.isNumber() && newData.val() > now && newData.val() < now + 30000"
        },
        "cancelled": {
          ".write": "auth != null && (auth.uid === data.parent().child('host').val() || auth.uid === data.parent().child('guest').val())",
          ".validate": "newData.val() === true"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (data.parent().parent().child('host').val() === $uid || data.parent().parent().child('guest').val() === $uid)",
            ".validate": "newData.hasChildren(['nick', 'avatar', 'score', 'at'])",
            "nick": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 16" },
            "avatar": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 31" },
            "score": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50000000" },
            "taps": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3000" },
            "tps10": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 250" },
            "done": { ".validate": "newData.isBoolean()" },
            "at": { ".validate": "newData.val() === now" },
            "$other": { ".validate": false }
          }
        },
        "items": {
          "$item": {
            ".write": "auth != null && !data.exists() && $item.beginsWith(auth.uid + '-') && (data.parent().parent().child('host').val() === auth.uid || data.parent().parent().child('guest').val() === auth.uid)",
            ".validate": "$item.matches(/^[A-Za-z0-9]+-[0-9]$/) && newData.hasChildren(['type', 'at'])",
            "type": { ".validate": "newData.val() === 'CLOCK' || newData.val() === 'SLOW' || newData.val() === 'STOP'" },
            "at": { ".validate": "newData.val() === now" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
