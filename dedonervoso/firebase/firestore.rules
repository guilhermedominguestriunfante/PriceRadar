rules_version = '2';

// Dedo Nervoso — Firestore security rules.
// Players only ever write their own documents, with plausible values; everything is readable by
// signed-in players (rankings). Paste into Firebase console → Firestore → Rules, or deploy with
// `firebase deploy --only firestore:rules` from this folder.
service cloud.firestore {
  match /databases/{database}/documents {

    // Oldest app version allowed to write online data. Raise it together with
    // minOnlineVersionCode when a release changes the online format.
    function minAppVersion() { return 2; }

    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function count(x, max) { return x is int && x >= 0 && x <= max; }
    function nick(n) { return n is string && n.size() >= 2 && n.size() <= 16; }
    function code(c) { return c is string && c.matches('^[A-HJ-NP-Z2-9]{6}$'); }
    function stamped(d) { return d.updatedAt == request.time; }
    // Weekly scores: at most one write every 2 s per player (a match lasts 60 s).
    function notTooFast() { return request.time > resource.data.updatedAt + duration.value(2, 's'); }

    function validPlayer(d) {
      return d.keys().hasOnly(['nick', 'code', 'avatar', 'bestScore', 'bestTaps', 'bestTps10', 'bestStage',
                               'level', 'appVersion', 'friends', 'updatedAt'])
        && d.keys().hasAll(['nick', 'code', 'avatar', 'bestScore', 'appVersion', 'friends', 'updatedAt'])
        && nick(d.nick) && code(d.code) && count(d.avatar, 31)
        && count(d.bestScore, 50000000) && count(d.get('bestTaps', 0), 3000) && count(d.get('bestTps10', 0), 250)
        && count(d.get('bestStage', 0), 9999) && count(d.get('level', 0), 9999)
        && d.appVersion is int && d.appVersion >= minAppVersion()
        && d.friends is list && d.friends.size() <= 100
        && stamped(d);
    }

    match /players/{uid} {
      allow read: if signedIn();
      // The friend code must be one this player reserved (in the same commit on creation).
      allow create: if owner(uid) && validPlayer(request.resource.data)
        && getAfter(/databases/$(database)/documents/codes/$(request.resource.data.code)).data.uid == uid;
      allow update: if owner(uid) && validPlayer(request.resource.data)
        && request.resource.data.code == resource.data.code
        && request.resource.data.bestScore >= resource.data.bestScore;
      allow delete: if owner(uid);
    }

    // Friend codes → player. Created once by their owner, never reassigned.
    match /codes/{c} {
      allow read: if signedIn();
      allow create: if signedIn() && code(c)
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Weekly boards (ISO week, e.g. 2026-W40): each player's best of the week.
    match /weeks/{week}/scores/{uid} {
      allow read: if signedIn();
      allow create, update: if owner(uid) && week.matches('^[0-9]{4}-W[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['nick', 'avatar', 'score', 'stage', 'taps', 'tps10', 'appVersion', 'updatedAt'])
        && nick(request.resource.data.nick) && count(request.resource.data.avatar, 31)
        && count(request.resource.data.score, 50000000) && count(request.resource.data.stage, 9999)
        && count(request.resource.data.taps, 3000) && count(request.resource.data.tps10, 250)
        && request.resource.data.appVersion is int && request.resource.data.appVersion >= minAppVersion()
        && stamped(request.resource.data)
        && (resource == null || (request.resource.data.score >= resource.data.score && notTooFast()));
      allow delete: if owner(uid);
    }
  }
}
